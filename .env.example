# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/letalk-leads"

# Pool settings (optional — defaults shown)
DB_CONNECTION_LIMIT=10
DB_POOL_TIMEOUT=10000

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=3001
FRONTEND_URL=http://localhost:3000

# Set to "prod" in production (enables SSL on the PostgreSQL pool)
# NODE_ENV=prod

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# AWS S3 — production / real AWS
# ---------------------------------------------------------------------------
# Leave AWS_S3_ENDPOINT unset (or empty). The SDK uses the regional endpoint.
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET_NAME=letalk-leads
AWS_S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Required IAM permissions on the bucket prefix batch-imports/*:
#   s3:PutObject, s3:GetObject
#
# Required S3 bucket CORS (browser direct upload from frontend):
#   AllowedMethods: PUT, GET, HEAD
#   AllowedOrigins: http://localhost:3000 (and your production URL)
#   AllowedHeaders: *

# ---------------------------------------------------------------------------
# AWS S3 — local MinIO (alternative dev setup)
# ---------------------------------------------------------------------------
# AWS_S3_ENDPOINT=http://localhost:9000
# AWS_S3_REGION=us-east-1
# AWS_S3_BUCKET_NAME=letalk-leads
# AWS_S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
